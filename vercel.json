{
  "version": 2,
  "builds": [
    {
      "src": "app.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "app.py"
    }
  ],
  "crons": [
    {
      "path": "/start",
      "schedule": "15 3 * * 1-5"
    },
    {
      "path": "/scan",
      "schedule": "50 3 * * 1-5"
    }
  ]
}
